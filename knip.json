{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["test/e2e/fixtures/**"],
  "workspaces": {
    ".": {
      "entry": ["skills/*/scripts/*.{js,mjs}", "skills/*/scripts/probes/*.js"],
      "ignoreDependencies": ["changelogen", "lint-staged"],
      "ignoreBinaries": ["taskkill", "agent-browser", "ffmpeg"]
    },
    "packages/wcagify-reporter": {
      "entry": [
        "locales/*.ts",
        "app/app.config.ts",
        "app/components/**/*.vue",
        "app/composables/**/*.ts"
      ],
      "project": ["src/**/*.ts", "app/**/*.{ts,vue}", "locales/**/*.ts"],
      "ignoreDependencies": ["@iconify-json/lucide", "@nuxt/fonts", "@nuxtjs/i18n", "vue"],
      "ignoreUnresolved": ["#build/ui/prose/pre"]
    },
    "packages/wcagify": {
      "entry": [
        "locales/*.ts",
        "app/app.vue",
        "app/error.vue",
        "app/pages/**/*.vue",
        "app/layouts/**/*.vue",
        "app/components/**/*.vue",
        "app/composables/**/*.ts",
        "app/middleware/**/*.ts",
        "app/plugins/**/*.ts",
        "server/**/*.ts"
      ],
      "project": ["src/**/*.ts", "app/**/*.{ts,vue}", "server/**/*.ts", "locales/**/*.ts"],
      "ignoreDependencies": [
        "@iconify-json/lucide",
        "@iconify-json/simple-icons",
        "@nuxt/a11y",
        "@nuxt/icon",
        "@nuxtjs/i18n",
        "vue",
        "nitropack",
        "h3"
      ],
      "ignoreUnresolved": ["#app"]
    },
    "packages/create-wcagify": {},
    "packages/browser-extension": {
      "entry": [
        "src/background/service-worker.ts",
        "src/content/element-picker.ts",
        "src/popup/main.ts",
        "manifest.config.ts"
      ],
      "project": ["src/**/*.{ts,vue}"]
    },
    "playground": {
      "entry": ["content.config.ts"],
      "ignoreDependencies": ["vue-tsc"]
    },
    "docs": {
      "ignoreDependencies": ["vue"]
    }
  }
}
